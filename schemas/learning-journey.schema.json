{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frbread7.github.io/books/schemas/learning-journey.schema.json",
  "title": "My Library Lifelong Learning Journey",
  "type": "object",
  "required": [
    "schemaVersion",
    "reviewDate",
    "references",
    "stages",
    "strands",
    "concepts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reviewDate": {
      "type": "string",
      "format": "date"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "version",
          "reviewedOn",
          "title",
          "url",
          "use"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "official-curriculum",
              "professional-guidance",
              "university-catalog",
              "reference-audit",
              "research-report"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "reviewedOn": {
            "type": "string",
            "format": "date"
          },
          "title": {
            "$ref": "#/$defs/localized"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "use": {
            "$ref": "#/$defs/localized"
          },
          "reuseLimit": {
            "$ref": "#/$defs/localized"
          }
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "ageRange",
          "label",
          "description",
          "guidanceOnly"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "ageRange": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "label": {
            "$ref": "#/$defs/localized"
          },
          "description": {
            "$ref": "#/$defs/localized"
          },
          "guidanceOnly": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    },
    "strands": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "$ref": "#/$defs/localized"
          },
          "description": {
            "$ref": "#/$defs/localized"
          }
        },
        "additionalProperties": false
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "threadId",
          "threadTitle",
          "strandId",
          "stageId",
          "depth",
          "title",
          "description",
          "prerequisites",
          "revisits",
          "authority",
          "sourceIds",
          "plannedBookIds",
          "publishedMaterials"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "threadId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "threadTitle": {
            "$ref": "#/$defs/localized"
          },
          "strandId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "stageId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "depth": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "$ref": "#/$defs/localized"
          },
          "description": {
            "$ref": "#/$defs/localized"
          },
          "prerequisites": {
            "type": "array",
            "description": "Explicit preparation that is meaningfully useful for this concept; stage continuity belongs in revisits and does not impose a progression gate.",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "revisits": {
            "description": "An earlier concept in the same strand thread that this stage revisits for greater depth; this is continuity guidance, not a prerequisite.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "authority": {
            "enum": [
              "official-domain-informed",
              "professional-recommendation",
              "editorial-proposal"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "plannedBookIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "publishedMaterials": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "bookId",
                "chapterId",
                "why"
              ],
              "properties": {
                "bookId": {
                  "type": "string"
                },
                "chapterId": {
                  "type": "string"
                },
                "why": {
                  "$ref": "#/$defs/localized"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": [
        "en",
        "ko"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ko": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
